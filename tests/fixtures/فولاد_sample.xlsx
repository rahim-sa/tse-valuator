<!----><app-statement _ngcontent-eav-c0="" _nghost-eav-c1=""><div _ngcontent-eav-c1="" style="direction: rtl;"><!----><div _ngcontent-eav-c1=""><!----><div _ngcontent-eav-c1="" class="sheet-container"><app-sheet _ngcontent-eav-c1="" _nghost-eav-c2=""><!----><div _ngcontent-eav-c2="" class="table-containet"><!----><div _ngcontent-eav-c2="" class="table-title ng-binding ng-scope">صورت سود و زیان</div><!----><div _ngcontent-eav-c2="" class="table-description ng-binding ng-scope">کلیه مبالغ به میلیون ريال است</div><app-table _ngcontent-eav-c2="" _nghost-eav-c3=""><table _ngcontent-eav-c3="" class="rayanDynamicStatement"><thead _ngcontent-eav-c3=""><!----><tr _ngcontent-eav-c3=""><!----><th _ngcontent-eav-c3="" rowspan="2" colspan="1"><span _ngcontent-eav-c3="">شرح</span></th><th _ngcontent-eav-c3="" rowspan="1" colspan="1"><span _ngcontent-eav-c3="">دوره منتهي به ۱۴۰۰/۱۲/۲۹</span></th><th _ngcontent-eav-c3="" rowspan="1" colspan="1"><span _ngcontent-eav-c3="">تجدید ارائه شده دوره منتهی به ۱۳۹۹/۱۲/۳۰</span></th><th _ngcontent-eav-c3="" rowspan="2" colspan="1"><span _ngcontent-eav-c3="">درصد تغییر</span></th></tr><tr _ngcontent-eav-c3=""><!----><th _ngcontent-eav-c3="" rowspan="1" colspan="1"><span _ngcontent-eav-c3="">حسابرسی شده</span></th><th _ngcontent-eav-c3="" rowspan="1" colspan="1"><span _ngcontent-eav-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-eav-c3=""><!----><tr _ngcontent-eav-c3=""><!----><td _ngcontent-eav-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-eav-c3="" style="color: #055274;">عملیات در حال تداوم: </span></td><td _ngcontent-eav-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-eav-c3="" style="color: #055274;"> </span></td><td _ngcontent-eav-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-eav-c3="" style="color: #055274;"> </span></td><td _ngcontent-eav-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-eav-