<h3>
صورت سود و زیان تلفیقی
</h3>
<hr>
</div>
<br>
<!----><app-statement _ngcontent-kyv-c0="" _nghost-kyv-c1=""><div _ngcontent-kyv-c1="" style="direction: rtl;"><!----><div _ngcontent-kyv-c1=""><!----><div _ngcontent-kyv-c1="" class="sheet-container"><app-sheet _ngcontent-kyv-c1="" _nghost-kyv-c2=""><!----><div _ngcontent-kyv-c2="" class="table-containet"><!----><div _ngcontent-kyv-c2="" class="table-title ng-binding ng-scope">صورت سود و زيان تلفيقي</div><!----><app-table _ngcontent-kyv-c2="" _nghost-kyv-c3=""><table _ngcontent-kyv-c3="" class="rayanDynamicStatement"><thead _ngcontent-kyv-c3=""><!----><tr _ngcontent-kyv-c3=""><!----><th _ngcontent-kyv-c3="" rowspan="2" colspan="1"><span _ngcontent-kyv-c3="">شرح</span></th><th _ngcontent-kyv-c3="" rowspan="1" colspan="1"><span _ngcontent-kyv-c3="">دوره منتهي به ۱۴۰۴/۱۲/۲۹</span></th><th _ngcontent-kyv-c3="" rowspan="1" colspan="1"><span _ngcontent-kyv-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۳/۱۲/۳۰</span></th><th _ngcontent-kyv-c3="" rowspan="2" colspan="1"><span _ngcontent-kyv-c3="">درصد تغيير</span></th></tr><tr _ngcontent-kyv-c3=""><!----><th _ngcontent-kyv-c3="" rowspan="1" colspan="1"><span _ngcontent-kyv-c3="">حسابرسی شده</span></th><th _ngcontent-kyv-c3="" rowspan="1" colspan="1"><span _ngcontent-kyv-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-kyv-c3=""><!----><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">عمليات در حال تداوم: </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;"> </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;"> </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;"> </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">درآمدهاي عملياتي </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۵,۲۴۳,۳۰۷,۸۸۲ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۳,۷۳۹,۱۹۱,۳۷۳ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۴۰ </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">بهاى تمام شده درآمدهاي عملياتي </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;" class="is-negative">(۳,۴۹۳,۴۱۴,۵۲۹) </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;" class="is-negative">(۲,۴۰۱,۶۱۰,۸۸۷) </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;" class="is-negative">(۴۵) </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">سود(زيان) ناخالص </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-kyv-c3="" style="color: #055274;">۱,۷۴۹,۸۹۳,۳۵۳ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-kyv-c3="" style="color: #055274;">۱,۳۳۷,۵۸۰,۴۸۶ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-kyv-c3="" style="color: #055274;">۳۱ </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">هزينه ‏هاى فروش، ادارى و عمومى </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;" class="is-negative">(۳۱۱,۱۲۹,۰۸۱) </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;" class="is-negative">(۱۹۲,۹۳۵,۱۱۶) </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;" class="is-negative">(۶۱) </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">هزينه کاهش ارزش دريافتني‏ها (هزينه استثنايي) </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;"> </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">ساير درآمدها </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۹۵,۳۷۸,۴۱۲ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۸۵,۳۵۸,۹۴۴ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۱۲ </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">ساير هزينه‌ها </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;" class="is-negative">(۳۱,۸۷۶,۰۴۰) </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;" class="is-negative">(۳۵,۷۰۱,۹۷۹) </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۱۱ </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">سود(زيان) عملياتى </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-kyv-c3="" style="color: #055274;">۱,۵۰۲,۲۶۶,۶۴۴ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-kyv-c3="" style="color: #055274;">۱,۱۹۴,۳۰۲,۳۳۵ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-kyv-c3="" style="color: #055274;">۲۶ </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">هزينه‏ هاى مالى </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;" class="is-negative">(۳۰۱,۸۶۵,۳۶۲) </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;" class="is-negative">(۱۷۴,۴۰۹,۵۴۸) </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;" class="is-negative">(۷۳) </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">ساير درآمدها و هزينه ‏هاى غيرعملياتى </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۱۷۰,۳۹۱,۹۴۴ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۱۳۹,۴۰۰,۱۵۷ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۲۲ </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">سود قبل از احتساب سهم گروه از سود شرکت‌هاي وابسته و مشارکت هاي خاص </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-kyv-c3="" style="color: #055274;">۱,۳۷۰,۷۹۳,۲۲۶ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-kyv-c3="" style="color: #055274;">۱,۱۵۹,۲۹۲,۹۴۴ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-kyv-c3="" style="color: #055274;">۱۸ </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">سهم گروه از سود مشارکت هاي خاص </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;"> </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-kyv-c3="" style="color: #055274;">سهم گروه از سود شرکت‌هاي وابسته </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۲۱۹,۴۹۵,۸۵۲ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۱۹۹,۳۹۳,۱۹۰ </span></td><td _ngcontent-kyv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-kyv-c3="" style="color: #055274;">۱۰ </span></td></tr><tr _ngcontent-kyv-c3=""><!----><td _ngcon