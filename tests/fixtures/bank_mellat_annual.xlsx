        }

        .wrapper {
            width: 90%;
            margin: 0 auto;
        }

        .ui-tinytbl-lastrow, .ui-tinytbl-lastrow th {
            border-bottom: none;
        }

        .ui-tinytbl-firstcol, .firstcol {
            border-right: solid 1px #BCBCBC;
        }

        .printButton {
            float: left;
            *margin-top: -15px;
        }

        .Hidden {
            display: none;
        }
