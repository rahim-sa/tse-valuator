<!----><app-statement _ngcontent-pxv-c0="" _nghost-pxv-c1=""><div _ngcontent-pxv-c1="" style="direction: rtl;"><!----><div _ngcontent-pxv-c1=""><!----><div _ngcontent-pxv-c1="" class="sheet-container"><app-sheet _ngcontent-pxv-c1="" _nghost-pxv-c2=""><!----><div _ngcontent-pxv-c2="" class="table-containet"><!----><div _ngcontent-pxv-c2="" class="table-title ng-binding ng-scope">صورت سود و زيان تلفيقي</div><!----><app-table _ngcontent-pxv-c2="" _nghost-pxv-c3=""><table _ngcontent-pxv-c3="" class="rayanDynamicStatement"><thead _ngcontent-pxv-c3=""><!----><tr _ngcontent-pxv-c3=""><!----><th _ngcontent-pxv-c3="" rowspan="2" colspan="1"><span _ngcontent-pxv-c3="">شرح</span></th><th _ngcontent-pxv-c3="" rowspan="1" colspan="1"><span _ngcontent-pxv-c3="">دوره منتهي به ۱۴۰۴/۰۶/۳۱</span></th><th _ngcontent-pxv-c3="" rowspan="1" colspan="1"><span _ngcontent-pxv-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۳/۰۶/۳۱</span></th><th _ngcontent-pxv-c3="" rowspan="2" colspan="1"><span _ngcontent-pxv-c3="">درصد تغيير</span></th></tr><tr _ngcontent-pxv-c3=""><!----><th _ngcontent-pxv-c3="" rowspan="1" colspan="1"><span _ngcontent-pxv-c3="">حسابرسی نشده</span></th><th _ngcontent-pxv-c3="" rowspan="1" colspan="1"><span _ngcontent-pxv-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-pxv-c3=""><!----><tr _ngcontent-pxv-c3=""><!----><td _ngcontent-pxv-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-pxv-c3="" style="color: #055274;">عمليات در حال تداوم: </span></td><td _ngcontent-pxv-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-pxv-c3="" style="color: #055274;"> </span></td><td _ngcontent-pxv-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-pxv-c3="" style="color: #055274;"> </span></td><td _ngcontent-pxv-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-pxv-c3="" style="color: #055274;"> </span></td></tr><tr _ngcontent-pxv-c3=""><!----><td _ngcontent-pxv-